@ControlDeDinero.Api_HostAddress = http://localhost:5201

### Create a client (use fictional data only)
POST {{ControlDeDinero.Api_HostAddress}}/api/clients
Content-Type: application/json

{
  "name": "Ana Prueba",
  "phone": "8888-0000",
  "notes": "Cliente de prueba"
}

### List / search clients (add &includeInactive=true to see deactivated ones)
GET {{ControlDeDinero.Api_HostAddress}}/api/clients?search=ana

### Get one client: replace the id with one returned above
GET {{ControlDeDinero.Api_HostAddress}}/api/clients/00000000-0000-0000-0000-000000000000

### Update a client
PUT {{ControlDeDinero.Api_HostAddress}}/api/clients/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "name": "Ana Prueba",
  "phone": "8888-1111",
  "notes": "Cambió de número"
}

### Deactivate
POST {{ControlDeDinero.Api_HostAddress}}/api/clients/00000000-0000-0000-0000-000000000000/deactivate

### Activate
POST {{ControlDeDinero.Api_HostAddress}}/api/clients/00000000-0000-0000-0000-000000000000/activate

###############################################################################
# Since the fifth round every request above (and below) needs a token.
# Add this line to each of them:   Authorization: Bearer TOKEN
###############################################################################

### Login: the only endpoint that works without a token. Copy "token" from the response.
POST {{ControlDeDinero.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "you@example.com",
  "password": "your password"
}

### Who am I? Replace TOKEN with the token from the login response
GET {{ControlDeDinero.Api_HostAddress}}/api/auth/me
Authorization: Bearer TOKEN

### Change my password (returns a new token; the old one stops working)
POST {{ControlDeDinero.Api_HostAddress}}/api/auth/change-password
Authorization: Bearer TOKEN
Content-Type: application/json

{
  "currentPassword": "current password",
  "newPassword": "new password, 10+ characters"
}
